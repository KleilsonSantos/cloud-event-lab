# Copy to .env (never commit .env)

# --- API ---
SPRING_PROFILES_ACTIVE=local
LAB_SECURITY_USERNAME=lab
LAB_SECURITY_PASSWORD=lab-change-me

# JDBC (host port 5433)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cloudeventlab
SPRING_DATASOURCE_USERNAME=lab
SPRING_DATASOURCE_PASSWORD=lab

# --- Web ---
VITE_LAB_USER=lab
VITE_LAB_PASSWORD=lab-change-me

# --- AWS / LocalStack (profile aws) ---
# LOCALSTACK_AUTH_TOKEN=
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_ENDPOINT_URL=http://localhost:4566

# --- Azure / Azurite (profile azure) ---
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- GCP (profile gcp) ---
# PUBSUB_EMULATOR_HOST=localhost:8085
# GOOGLE_CLOUD_PROJECT=cloud-event-lab-local
